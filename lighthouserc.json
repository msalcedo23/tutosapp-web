{
  "ci": {
    "collect": {
      "staticDistDir": "./site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/servicios/index.html",
        "http://localhost/en/services/index.html",
        "http://localhost/ojito/index.html",
        "http://localhost/ojito/en/index.html",
        "http://localhost/resume-roast/index.html",
        "http://localhost/resume-roast/es/index.html",
        "http://localhost/roast-interview/index.html",
        "http://localhost/roast-interview/es/index.html",
        "http://localhost/ojito/privacidad/index.html",
        "http://localhost/resume-roast/terms/index.html",
        "http://localhost/roast-interview/es/privacidad/index.html",
        "http://localhost/privacidad/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
